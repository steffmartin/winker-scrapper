# Segurança e Credenciais
.env

# Bancos de dados locais estruturados
database/*.db
database/*.db.bak*
# Arquivos auxiliares SQLite podem conter os mesmos dados privados do banco.
database/*.db-*

# Caches e arquivos compilados do Python (em qualquer subdiretório)
**/__pycache__/
**/*.pyc

# Pastas de dados e downloads
anexos/

# Cache e estado do Playwright
**/.playwright-mcp/

# Compilados do Frontend (builds de produção do Angular)
compilados/

# IDEs e Sandboxes
/.idea/
scratch/

# Configurações
config/*.config
!config/example.config

# Atalhos
*.lnk

# Artefatos privados da skill: fontes, OCR, caches, SQLs e relatórios por competência.
# SKILL.md, PATTERNS.md, scripts reutilizáveis e testes sintéticos continuam versionáveis.
/.agents/skills/pdf-prestacao-contas/artifacts/
